{
  "name": "mda",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:migrate": "bun run --filter @mda/control-plane db:migrate",
    "dev": "bun run --filter @mda/control-plane dev",
    "mda": "bun apps/cli/src/main.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/bun": "1.4.0",
    "typescript": "7.0.2"
  }
}
