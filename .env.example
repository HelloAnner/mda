MDA_CONFIG=./mda.toml
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgres://mda_main:change-me@localhost:5432/mda_main
POSTGRES_PASSWORD=replace-with-random-postgres-password
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=replace-with-random-redis-password
MDA_AUTH_MODE=password
MDA_LOCAL_TENANT=local
MDA_LOCAL_USER=local-admin
OIDC_ISSUER=https://identity.example
OIDC_AUDIENCE=mda
OIDC_JWKS_URL=https://identity.example/.well-known/jwks.json
INTERNAL_AGENT_TOKEN=replace-with-at-least-32-random-characters
MDA_AGENT_WORKERS=8
MDA_ACCESS_PASSWORD=replace-with-at-least-16-random-characters
MDA_MODEL_API_KEY=replace-with-model-provider-key
MDA_MODEL_API_KEY_FILE=./var/secrets/model_api_key
LLM_BASE_URL=https://model-provider.example/v1
LLM_MODEL_NAME=model-id

MDA_API_URL=http://localhost:8080
MDA_TENANT=local
MDA_TOKEN=oidc-access-token
